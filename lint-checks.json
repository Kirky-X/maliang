    {
      "name": "禁用语表",
      "type": "forbid-pattern",
      "files": ["README.md", "README_EN.md", "SKILL.md"],
      "pattern": "完美|革命性|颠覆性|行业第一|首屈一指|保证通过|绝对领先",
      "severity": "FAIL"
    },
    {
      "name": "模板墙唯一入口链接",
      "type": "require-pattern",
      "file": "SKILL.md",
      "pattern": "references/templates/INDEX\\.md",
      "min_count": 1,
      "severity": "FAIL"
    },
    {
      "name": "依赖声明",
      "type": "require-pattern",
      "file": "README.md",
