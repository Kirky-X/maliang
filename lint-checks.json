{
  "external_paths": [
    "ui/",
    "setting/",
    "temp/",
    "google/",
    "organisms/",
    "examples/",
    "docs/",
    "reference/"
  ],
  "checks": [
    {
      "name": "设计语言计数对账",
      "type": "count-matches",
      "source": "references/templates/INDEX.md",
      "section": "## 设计语言",
      "row_pattern": "^\\|\\s*\\[",
      "claim_files": [
        "SKILL.md",
        "README.md",
        "README_EN.md"
      ],
      "claim_patterns": [
        "(\\d+)\\s*种设计语言",
        "(\\d+)\\s+design languages"
      ],
      "min_claims": 1,
      "severity": "FAIL"
    },
    {
      "name": "禁用语表",
      "type": "forbid-pattern",
      "files": [
        "README.md",
        "README_EN.md",
        "SKILL.md"
      ],
      "pattern": "完美|革命性|颠覆性|行业第一|首屈一指|保证通过|绝对领先",
      "severity": "FAIL"
    },
    {
      "name": "模板墙唯一入口链接",
      "type": "require-pattern",
      "file": "SKILL.md",
      "pattern": "references/templates/INDEX\\.md",
      "min_count": 1,
      "severity": "FAIL"
    },
    {
      "name": "依赖声明",
      "type": "require-pattern",
      "file": "README.md",
      "pattern": "纯 Python 标准库",
      "min_count": 1,
      "severity": "FAIL"
    },
    {
      "name": "neumorphism 阴影配方正本",
      "type": "require-pattern",
      "file": "references/templates/neumorphism.md",
      "pattern": "9px 9px 16px rgba\\(163,177,198,\\.6\\)",
      "min_count": 1,
      "severity": "FAIL"
    },
    {
      "name": "范例不得自带与模板冲突的阴影值",
      "type": "forbid-pattern",
      "files": [
        "examples/design-system/neomorphism/DESIGN.md"
      ],
      "pattern": "BEBEC1",
      "severity": "FAIL"
    },
    {
      "name": "draw fallback 规范句跨文件一致",
      "type": "consistency",
      "files": [
        "references/commands/draw-md.md",
        "references/commands/draw-element.md",
        "references/commands/draw-flutter.md",
        "references/commands/draw-harmony.md"
      ],
      "pattern": "^\\| DESIGN\\.md 缺失关键 token.*\\|$",
      "severity": "FAIL"
    },
    {
      "name": "
      "type": "forbid-pattern",
      "files": [
        "SKILL.md",
        "README.md",
        "README_EN.md",
        "references/commands/critique.md"
      ],
      "pattern": "e3d624b",
      "severity": "FAIL"
    },
    {
      "name": "
      "type": "require-pattern",
      "file": "references/meta/web-interface-guidelines.md",
      "pattern": "sha [0-9a-f]{7,40}",
      "min_count": 1,
      "severity": "FAIL"
    },
    {
      "name": "兄弟 skill 引用存在性",
      "type": "sibling-skills",
      "siblings": [
        "diting",
        "tiangang",
        "hap-dev",
        "flutter-dev",
        "element-dev",
        "wudaozi"
      ],
      "severity": "FAIL"
    }
  ]
}
